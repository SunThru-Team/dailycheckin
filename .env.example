# Postgres (Neon / Supabase / Vercel Postgres). Include ?sslmode=require if the provider needs it.
DATABASE_URL=postgres://user:pass@host/db

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_FROM_NUMBER=+15550001111

# Who gets the evening briefing call
CEO_PHONE_NUMBER=+15550002222

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Deployed URL, no trailing slash. Twilio webhooks and signature validation are built from this.
PUBLIC_BASE_URL=https://your-project.vercel.app

# Random string; Vercel sends it as "Authorization: Bearer <CRON_SECRET>" on cron hits.
CRON_SECRET=change-me

# Random string; the executive dashboard lives at /x/<ADMIN_TOKEN>
ADMIN_TOKEN=change-me-too

# IANA zone used to decide what "today" means and to display times.
ORG_TIMEZONE=America/New_York

# Set to "false" ONLY for local testing without Twilio signatures.
TWILIO_VALIDATE_SIGNATURE=true
